# ── Core ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/db
API_BASE_URL=https://api.example.com          # public URL of THIS backend (used for OAuth callbacks)
FRONTEND_ORIGIN=https://example.com           # public URL of the frontend
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encrypts OAuth tokens / customer API keys in the database (AES-256-GCM).
# Generate:  openssl rand -base64 32
# Then encrypt existing rows once:  npx ts-node scripts/encrypt-existing-tokens.ts
INTEGRATION_ENCRYPTION_KEY=

# ── Messaging / billing ───────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_DOMAIN=
SENDGRID_REPLY_DOMAIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STRIPE_SECRET_KEY=

# ── Calendar polling ──────────────────────────────────────────────────
CONNECTORS_POLLING=on                         # "off" disables the background poller
CONNECTORS_POLL_SECONDS=120

# ── Integrations: OAuth apps (a provider is offered only if its vars are set) ──
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
WEBHOOK_SQUARE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
ACUITY_CLIENT_ID=
ACUITY_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=                          # Azure portal → App registrations. Redirect URI: ${API_BASE_URL}/connectors/oauth/microsoft/callback
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
CALENDLY_CLIENT_ID=                           # Redirect URI: ${API_BASE_URL}/connectors/oauth/calendly/callback
CALENDLY_CLIENT_SECRET=
CLIO_CLIENT_ID=                               # Redirect URI: ${API_BASE_URL}/connectors/oauth/clio/callback
CLIO_CLIENT_SECRET=
CLIO_BASE_URL=https://app.clio.com            # https://eu.app.clio.com etc. for other regions

# ── Unverified providers: written without vendor docs/accounts. OFF unless this is "true". ──
ENABLE_UNVERIFIED_PROVIDERS=false
JOBBER_CLIENT_ID=                             # Redirect URI: ${API_BASE_URL}/connectors/oauth/jobber/callback
JOBBER_CLIENT_SECRET=
JOBBER_GRAPHQL_VERSION=2025-01-20             # must be a version Jobber currently accepts
ZOHO_CLIENT_ID=                               # Redirect URI: ${API_BASE_URL}/connectors/oauth/zoho/callback
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com   # .eu / .in / .com.au for other data centres
OPEN_DENTAL_DEVELOPER_KEY=                    # issued to Gaplets by Open Dental; each office pastes its own customer key

# Cliniko and Cal.com need NO server credentials: each customer pastes their own API key in the dashboard.
